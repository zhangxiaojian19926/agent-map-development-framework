page {
  background: #f6f4ef;
  color: #1c1915;
  font-size: 30rpx;
  line-height: 1.55;
}

.wrap {
  padding: 32rpx 32rpx 80rpx;
}

.card {
  background: #fffdf8;
  border: 1rpx solid #e4dccb;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.h1 {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.35;
  margin-bottom: 12rpx;
}

.h2 {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.muted {
  color: #5e584e;
}

.warn {
  color: #8a3d12;
}

.steps {
  margin: 12rpx 0 0;
  padding-left: 36rpx;
}

.steps .item {
  margin-bottom: 8rpx;
}

.btn {
  background: #0f6b4c;
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
}

.btn[disabled] {
  background: #b7c4bb;
  color: #fff;
}

.btn-ghost {
  background: transparent;
  color: #0f6b4c;
  border: 1rpx solid #0f6b4c;
  border-radius: 999rpx;
}

.btn-danger {
  background: #8a3d12;
  color: #fff;
  border-radius: 999rpx;
}

.row {
  display: flex;
  gap: 16rpx;
}

.grow {
  flex: 1;
}

.tabs {
  display: flex;
  background: #efe8da;
  border-radius: 999rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 999rpx;
  color: #5e584e;
}

.tab.on {
  background: #fffdf8;
  color: #1c1915;
  font-weight: 600;
}

.box {
  width: 100%;
  min-height: 280rpx;
  background: #fff;
  border: 1rpx solid #e4dccb;
  border-radius: 16rpx;
  padding: 16rpx;
  box-sizing: border-box;
}

.check {
  display: block;
  margin-top: 16rpx;
}

.list-item {
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0e8da;
}

.pill {
  display: inline-block;
  background: #efe8da;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  font-size: 24rpx;
}
