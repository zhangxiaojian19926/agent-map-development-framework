#!/usr/bin/env python3
"""Run the maintainer checks in the one order that keeps CI green.

Two failure modes this exists to prevent:

1. A file changed but `framework-manifest.json` was not refreshed, so
   `tools/check-framework` reports a fingerprint mismatch.
2. `git diff --check` was run before committing, which inspects the working
   tree or the index instead of the range CI inspects.

Usage:
  tools/pre-commit-check              refresh the manifest, then check the
                                       staged change the way CI will
  tools/pre-commit-check --committed   check the committed range CI will
                                       inspect, without touching the manifest
  tools/pre-commit-check --read-only   never write anything

Exit code is 0 only when every applicable check passed.
"""
import argparse
import os
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
GREEN = '\033[32m'
RED = '\033[31m'
DIM = '\033[2m'
RESET = '\033[0m'


def run(label, command, allow_failure=False):
    """Run one step and report it. Returns (ok, output)."""
    result = subprocess.run(command, cwd=str(ROOT), capture_output=True, text=True)
    output = (result.stdout + result.stderr).strip()
    ok = result.returncode == 0
    if ok:
        print('  %sPASS%s  %s' % (GREEN, RESET, label))
    else:
        print('  %sFAIL%s  %s' % (RED, RESET, label))
        for line in output.splitlines()[:12]:
            print('        %s' % line)
        if len(output.splitlines()) > 12:
            print('        %s...%s' % (DIM, RESET))
    if not ok and not allow_failure:
        print('\n%sFailed at: %s%s' % (RED, label, RESET))
    return ok, output


def committed_range():
    """The range CI inspects for a push: the previous tip to HEAD."""
    head = subprocess.run(['git', 'rev-parse', 'HEAD'], cwd=str(ROOT),
                          capture_output=True, text=True)
    if head.returncode != 0:
        return None
    parent = subprocess.run(['git', 'rev-parse', 'HEAD^'], cwd=str(ROOT),
                            capture_output=True, text=True)
    if parent.returncode != 0:
        return None
    return parent.stdout.strip(), head.stdout.strip()


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument('--committed', action='store_true',
                        help='check the committed range instead of the staged change')
    parser.add_argument('--read-only', action='store_true',
                        help='never write the manifest')
    parser.add_argument('--skip-tests', action='store_true',
                        help='skip the unit test suite')
    args = parser.parse_args(argv)

    print('Framework pre-commit check')
    print('-' * 60)

    if args.committed:
        # The manifest already had to be refreshed before the commit, so a
        # stale fingerprint here means the commit was made out of order.
        ok, _ = run('distribution check', ['python3', 'tools/check-framework'])
        if not ok:
            return 1
        span = committed_range()
        if not span:
            print('  SKIP  committed range check (no parent commit)')
            return 0
        base, head = span
        print('\n  %scommitted range %s..%s%s' % (DIM, base[:7], head[:7], RESET))
        ok, _ = run('whitespace in the committed range',
                    ['git', 'diff', '--check', base, head])
        if not ok:
            return 1
        print('\n%sAll committed-range checks passed.%s' % (GREEN, RESET))
        return 0

    if not args.read_only:
        ok, _ = run('refresh manifest', ['python3', 'tools/update-manifest'])
        if not ok:
            return 1
    else:
        print('  SKIP  refresh manifest (--read-only)')

    ok, _ = run('distribution check', ['python3', 'tools/check-framework'])
    if not ok:
        print('\n%sA fingerprint mismatch means the manifest is stale.%s' % (RED, RESET))
        return 1

    if not args.skip_tests:
        env = dict(os.environ, PYTHONDONTWRITEBYTECODE='1')
        result = subprocess.run(
            [sys.executable, '-m', 'unittest', 'discover', '-s', 'tests', '-q'],
            cwd=str(ROOT), capture_output=True, text=True, env=env)
        if result.returncode == 0:
            summary = [l for l in result.stderr.splitlines() if l.startswith('Ran ')]
            print('  %sPASS%s  unit tests%s' % (GREEN, RESET,
                                                (' (%s)' % summary[-1]) if summary else ''))
        else:
            print('  %sFAIL%s  unit tests' % (RED, RESET))
            for line in (result.stderr + result.stdout).splitlines()[-12:]:
                print('        %s' % line)
            return 1

    ok, _ = run('whitespace in the staged change', ['git', 'diff', '--cached', '--check'])
    if not ok:
        return 1

    print('\n%sAll pre-commit checks passed.%s' % (GREEN, RESET))
    print('%sAfter committing, run: tools/pre-commit-check --committed%s' % (DIM, RESET))
    return 0


if __name__ == '__main__':
    sys.exit(main())
