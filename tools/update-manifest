#!/usr/bin/env python3
"""Maintainer-only mechanical checksum refresh; inspect diff before publication."""
import importlib.machinery
import importlib.util
import json
from pathlib import Path
import sys
sys.dont_write_bytecode = True

root = Path(__file__).resolve().parents[1]
loader = importlib.machinery.SourceFileLoader('checker', str(root / 'tools/check-framework'))
spec = importlib.util.spec_from_loader(loader.name, loader)
checker = importlib.util.module_from_spec(spec)
loader.exec_module(checker)
path = root / 'framework-manifest.json'
manifest = json.loads(path.read_text())
manifest['files'] = checker.inventory(root)
# Skill counts follow the filesystem; a removed entry point must not leave a
# hand-maintained number behind.
groups = {}
for group in sorted((root / 'skill').iterdir()):
    if group.is_dir():
        groups[group.name.replace('-', '_')] = sum(1 for _ in group.rglob('SKILL.md'))
manifest['skills'] = groups
path.write_text(json.dumps(manifest, ensure_ascii=False, indent=2) + '\n')
print('Updated', len(manifest['files']), 'fingerprints and', len(groups), 'skill groups; inspect the diff.')
