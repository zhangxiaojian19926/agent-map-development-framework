#!/usr/bin/env python3
"""Read-only checks of the explicit public distribution (Python stdlib only)."""
import ast
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
from urllib.parse import unquote

MANIFEST = "framework-manifest.json"
SKIP = {".git", "__pycache__", ".DS_Store", ".superpowers"}
ROOT_FILES = {"AGENTS.md", "BOOTSTRAP.md", "README.md", "LICENSE", "THIRD_PARTY_NOTICES.md",
              "CHANGELOG.md", ".gitignore", ".gitattributes", MANIFEST}
ROOT_DIRS = {"docs", "skill", "templates", "tests", "tools", ".github", "openspec"}

def inventory(root):
    result = {}
    for directory, dirs, names in os.walk(root, followlinks=False):
        for name in list(dirs):
            path = Path(directory) / name
            if name in SKIP:
                dirs.remove(name)
            elif path.is_symlink():
                raise ValueError("Symlink directory: " + str(path.relative_to(root)))
        for name in names:
            path = Path(directory) / name
            rel = path.relative_to(root).as_posix()
            if name in SKIP or name.endswith(".pyc") or rel == MANIFEST:
                continue
            if path.is_symlink():
                raise ValueError("Symlink file: " + rel)
            result[rel] = hashlib.sha256(path.read_bytes()).hexdigest()
    return dict(sorted(result.items()))

def inventory_errors(root, expected):
    actual = inventory(root)
    errors = []
    for file in sorted(actual.keys() - expected.keys()):
        errors.append("unexpected file: " + file)
    for file in sorted(expected.keys() - actual.keys()):
        errors.append("missing file: " + file)
    for file in sorted(expected.keys() & actual.keys()):
        if expected[file] != actual[file]:
            errors.append("fingerprint mismatch: " + file)
    return errors

def exact_case_exists(root, path):
    """Path.exists() alone misses wrong-case links on case-insensitive hosts."""
    current = root.resolve()
    for part in path.relative_to(current).parts:
        if part not in os.listdir(current):
            return False
        current = current / part
    return True


def link_errors(root, file):
    text = re.sub(r"```[\s\S]*?```", "", file.read_text(encoding="utf-8"))
    errors = []
    for match in re.finditer(r"\[[^\]]*\]\(([^)]+)\)", text):
        target = match.group(1).split("#")[0]
        if not target or re.match(r"^[a-zA-Z][\w+.-]*:", target) or "<" in target or ">" in target:
            continue
        resolved = (file.parent / unquote(target)).resolve()
        try:
            resolved.relative_to(root.resolve())
        except ValueError:
            errors.append(str(file.relative_to(root)) + ": link escapes distribution")
            continue
        if not resolved.exists() or not exact_case_exists(root, resolved):
            errors.append(str(file.relative_to(root)) + ": broken link " + target)
    return errors

def invocation_errors(root, expected):
    """A skill must declare the same invocation form to every host.

    Claude Code reads `disable-model-invocation` in the skill frontmatter.
    Codex reads `policy.allow_implicit_invocation` in agents/openai.yaml. If
    only one side declares the form, that host reaches a skill the other
    host cannot, and the workflow stage that names it silently stops firing.
    """
    errors = []
    for rel in sorted(expected):
        if not rel.endswith("/SKILL.md"):
            continue
        skill = root / rel
        front = skill.read_text(encoding="utf-8")[:800]
        claude_user = "disable-model-invocation: true" in front
        yaml = skill.parent / "agents/openai.yaml"
        codex_user = False
        if yaml.is_file():
            codex_user = "allow_implicit_invocation: false" in yaml.read_text(encoding="utf-8")
        if claude_user and not codex_user:
            errors.append("invocation form declared for one host only: " + rel)
        if codex_user and not claude_user:
            errors.append("invocation form declared for one host only: " + rel)
    return errors


def emphasis_errors(root, rel, text):
    """Flag markdown paragraphs whose bold markers do not pair up.

    A stray `**` renders literally and hides the sentence it was meant to
    emphasise, which is easy to miss in a long specification.

    The count is per paragraph, not per line: bold text may span two lines,
    and counting lines would flag every such paragraph.
    """
    errors = []
    fenced = False
    paragraph = []
    start = 0
    number = 0
    for number, line in enumerate(text.splitlines(), 1):
        stripped = line.strip()
        if stripped.startswith("```"):
            fenced = not fenced
            continue
        if fenced:
            continue
        if not stripped:
            if paragraph:
                errors.extend(_paragraph_error(root, rel, start, paragraph))
                paragraph = []
            continue
        if not paragraph:
            start = number
        paragraph.append(line)
    if paragraph:
        errors.extend(_paragraph_error(root, rel, start, paragraph))
    return errors


def _paragraph_error(root, rel, start, lines):
    bare = re.sub(r"`[^`]*`", "", "\n".join(lines))
    if bare.count("**") % 2:
        return ["%s:%d: unbalanced bold marker" % (rel, start)]
    return []


WORKFLOW_CONTRACT = "docs/framework/development-workflow.md"
GUIDE = "docs/guide/from-zero-to-one.md"
STATUS_GUIDE = "docs/guide/framework-model.md"
VALIDATE_WORKFLOW = ".github/workflows/validate.yml"
RELEASE_WORKFLOW = ".github/workflows/release.yml"
BEIJING_UTC_OFFSET_HOURS = 8
# The state vocabulary the guides state is checked against the shipped code.
DICTIONARY_START = "<!-- status-dictionary:start -->"
DICTIONARY_END = "<!-- status-dictionary:end -->"
STATUS_TOKEN = re.compile(r"`([A-Z][A-Z0-9_]*(?:/[A-Z]+)?)`")

# Gate shapes recognised inside a CI workflow. The canonical name comes from the
# matched text, so a gate added to CI is picked up without editing this table.
GATE_SHAPES = (
    (re.compile(r"tools/(check-[A-Za-z0-9._-]+)"), r"\1"),
    (re.compile(r"openspec\s+validate\s+(--[a-z-]+)"), r"openspec validate \1"),
    (re.compile(r"\bunittest\b"), "unittest"),
    (re.compile(r"git\s+diff\s+--check"), "git diff --check"),
)
# Steps that prepare the runner instead of gating the change.
SETUP_SHAPES = (re.compile(r"^\s*(?:npm|pip|brew)\s+install\b", re.MULTILINE),)
# Documents that record what happened rather than what is true now. A change
# body quotes the value it replaces, so changes are history in both states.
HISTORICAL_FILES = ("CHANGELOG.md", "docs/maintainer/optimization-log.md")
HISTORICAL_PREFIXES = ("docs/archive/", "openspec/changes/")
# A UTC time only reads as a release schedule in a document that talks about one.
SCHEDULE_CONTEXT = ("release.yml", "每周一", "定时发布")
UTC_TIME = re.compile(r"(\d{1,2}:\d{2})\s*UTC")
LOCAL_TIME = re.compile(r"北京时间[^0-9]{0,6}(\d{1,2}:\d{2})")


def _read_text(root, rel):
    path = root / rel
    if not path.is_file():
        return None
    return path.read_text(encoding="utf-8")


def _section(text, prefix):
    """Return the body of the first level-2 section whose heading starts with prefix."""
    body = []
    inside = False
    for line in text.splitlines():
        if line.startswith("## "):
            if inside:
                break
            inside = line[3:].strip().startswith(prefix)
            continue
        if inside:
            body.append(line)
    return "\n".join(body) if inside else None


def _run_blocks(text):
    """Return the shell body of every `run:` step in a workflow file."""
    blocks = []
    lines = text.splitlines()
    index = 0
    while index < len(lines):
        match = re.match(r"^(\s*)(-\s+)?run:\s*(.*)$", lines[index])
        if not match:
            index += 1
            continue
        indent = len(match.group(1)) + len(match.group(2) or "")
        inline = match.group(3).strip()
        if inline and inline not in ("|", ">", "|-", ">-", "|+", ">+"):
            blocks.append(inline)
            index += 1
            continue
        index += 1
        body = []
        while index < len(lines):
            line = lines[index]
            if not line.strip():
                index += 1
                continue
            if len(line) - len(line.lstrip()) <= indent:
                break
            body.append(line.strip())
            index += 1
        blocks.append("\n".join(body))
    return blocks


def _ci_gates(text):
    """Return the gates a workflow runs in CI order, and the steps that are neither."""
    gates = []
    unknown = []
    for block in _run_blocks(text):
        names = []
        for pattern, template in GATE_SHAPES:
            for match in pattern.finditer(block):
                name = match.expand(template)
                if name not in names:
                    names.append(name)
        if names:
            gates.extend(names)
        elif not any(pattern.search(block) for pattern in SETUP_SHAPES):
            unknown.append(block)
    return gates, unknown


def _summary_step_errors(contract):
    """Check that the behaviour summary lists every step the implementation section declares."""
    body = _section(contract, "8. IMPLEMENT")
    if body is None:
        return ["workflow contract: implementation section not found"]
    steps = re.findall(r"^\s*\d+\.\s+([A-Z_]+):", body, re.MULTILINE)
    summary = None
    for line in contract.splitlines():
        if "TASK_SELECTED" in line and "→" in line:
            summary = line
            break
    if summary is None:
        return ["workflow contract: behaviour summary line not found"]
    declared = set(re.findall(r"[A-Z][A-Z_]+", summary))
    missing = [step for step in steps if step not in declared]
    if missing:
        return ["workflow contract: behaviour summary omits %s" % ", ".join(missing)]
    return []


def _guide_gate_errors(guide, validate):
    """Check that the guide lists every gate CI runs."""
    gates, unknown = _ci_gates(validate)
    errors = []
    for block in unknown:
        head = block.splitlines()[0] if block.splitlines() else block
        errors.append("validate workflow: unrecognised step, teach the checker its shape: " + head)
    body = _section(guide, "工作流 14")
    if body is None:
        errors.append("guide: verification workflow section not found")
        return errors
    for name in gates:
        if name not in body:
            errors.append("guide: verification workflow omits the gate " + name)
    return errors


def _schedule_time_errors(root, files, release):
    """Check that every live document states the scheduled release time CI actually uses."""
    expression = None
    for line in release.splitlines():
        stripped = line.strip()
        if stripped.startswith("#"):
            continue
        match = re.search(r"cron:\s*['\"]([^'\"]+)['\"]", stripped) or re.search(r"cron:\s*([^\s#]+)", stripped)
        if match:
            expression = match.group(1)
            break
    if expression is None:
        return []
    fields = expression.split()
    if len(fields) < 2 or not fields[0].isdigit() or not fields[1].isdigit():
        return ["release workflow: unsupported cron expression " + expression]
    minute, hour = int(fields[0]), int(fields[1])
    utc = "%02d:%02d" % (hour, minute)
    local = "%02d:%02d" % ((hour + BEIJING_UTC_OFFSET_HOURS) % 24, minute)
    errors = []
    for rel in _live_markdown(root, files):
        text = (root / rel).read_text(encoding="utf-8")
        if any(word in text for word in SCHEDULE_CONTEXT):
            for match in UTC_TIME.finditer(text):
                if match.group(1) != utc:
                    errors.append("%s: states %s UTC, the release workflow runs at %s UTC"
                                  % (rel, match.group(1), utc))
        for match in LOCAL_TIME.finditer(text):
            if match.group(1) != local:
                errors.append("%s: states Beijing time %s, the release workflow runs at %s"
                              % (rel, match.group(1), local))
    return errors


def _live_markdown(root, files):
    """Return the distribution markdown files that describe the current state."""
    live = []
    for rel in sorted(files):
        if not rel.endswith(".md"):
            continue
        if rel in HISTORICAL_FILES or rel.startswith(HISTORICAL_PREFIXES):
            continue
        if (root / rel).is_file():
            live.append(rel)
    return live


def doc_contract_errors(root, files):
    """Check that the workflow contract, the public guide and CI describe the same work."""
    sources = {
        WORKFLOW_CONTRACT: _read_text(root, WORKFLOW_CONTRACT),
        GUIDE: _read_text(root, GUIDE),
        VALIDATE_WORKFLOW: _read_text(root, VALIDATE_WORKFLOW),
        RELEASE_WORKFLOW: _read_text(root, RELEASE_WORKFLOW),
    }
    missing = [rel for rel, text in sources.items() if text is None]
    if missing:
        return ["document contract check needs: " + ", ".join(sorted(missing))]
    errors = _summary_step_errors(sources[WORKFLOW_CONTRACT])
    errors.extend(_guide_gate_errors(sources[GUIDE], sources[VALIDATE_WORKFLOW]))
    errors.extend(_schedule_time_errors(root, files, sources[RELEASE_WORKFLOW]))
    return errors


def status_dictionary_errors(root, expected):
    """Every status code the guides state must exist in the shipped code."""
    errors = []
    corpus = []
    for rel in expected:
        if not (rel.endswith(".py") or rel.endswith("SKILL.md")):
            continue
        if not rel.startswith(("tools/", "skill/")):
            continue
        try:
            corpus.append((root / rel).read_text(encoding="utf-8"))
        except (OSError, UnicodeDecodeError):
            continue
    blob = "\n".join(corpus)
    for rel in (GUIDE, STATUS_GUIDE):
        path = root / rel
        if not path.is_file():
            errors.append("status dictionary source missing: " + rel)
            continue
        text = path.read_text(encoding="utf-8")
        if DICTIONARY_START not in text or DICTIONARY_END not in text:
            errors.append(rel + ": status table is not marked for checking")
            continue
        body = text.split(DICTIONARY_START, 1)[1].split(DICTIONARY_END, 1)[0]
        codes = sorted(set(STATUS_TOKEN.findall(body)))
        if not codes:
            errors.append(rel + ": status table states no status code")
        for code in codes:
            if code not in blob:
                errors.append("%s: documents status %s which the shipped code never emits" % (rel, code))
    return errors


SKILL_ROUTING_DOCS = ('AGENTS.md', 'docs/framework/development-workflow.md',
                       'docs/framework/skill-policy.md', 'docs/guide/from-zero-to-one.md',
                       'docs/guide/framework-model.md')
CONTRACT_DOC = 'docs/framework/development-workflow.md'
LOCAL_LAYER_REGISTRY = 'skill/local-layers.json'


def _skill_names(expected):
    """Return the skill entrypoint names shipped in the distribution."""
    return sorted(rel.split('/')[-2] for rel in expected if rel.endswith('/SKILL.md'))


def _skill_pattern(name):
    """Match a skill name with or without a group prefix, never inside a longer name."""
    return r'(?<![\w-])(?:[\w-]+:)?' + re.escape(name) + r'(?![\w-])'


def _mentioned_skills(text, names):
    return {name for name in names if re.search(_skill_pattern(name), text)}


def _agents_routing(root, names):
    """Map stage name to the skills the AGENTS.md routing table assigns to it."""
    text = (root / 'AGENTS.md').read_text(encoding='utf-8')
    table = {}
    for line in text.splitlines():
        match = re.match(r'\|\s*\d+\.\s*([A-Z][A-Z ]*?)\s*\|([^|]*)\|', line)
        if not match:
            continue
        for name in _mentioned_skills(match.group(2), names):
            table.setdefault(name, set()).add(match.group(1).strip())
    return table


def _contract_stages(root, names):
    """Map skill name to the stages the development workflow contract assigns to it."""
    text = (root / CONTRACT_DOC).read_text(encoding='utf-8')
    stages = {}
    for section in re.split(r'\n## ', text):
        head = section.split('\n', 1)[0].lstrip('#').strip()
        match = re.match(r'\d+\.\s+([A-Z][A-Z/ ]*?)\s*(?:—|–|-|$)', head)
        if not match:
            continue
        body = section.split('\n', 1)[1] if '\n' in section else ''
        for name in _mentioned_skills(body, names):
            for stage in [part.strip() for part in match.group(1).split('/')]:
                stages.setdefault(name, set()).add(stage)
    return stages


def skill_routing_errors(root, expected):
    """Every shipped skill needs a landing place, and the two contracts must agree."""
    names = _skill_names(expected)
    errors = []
    mentioned = set()
    for rel in SKILL_ROUTING_DOCS:
        path = root / rel
        if not path.is_file():
            errors.append("skill routing source missing: " + rel)
            continue
        mentioned |= _mentioned_skills(path.read_text(encoding='utf-8'), names)
    for name in names:
        if name not in mentioned:
            errors.append("skill %s ships in the package but no live document routes it" % name)
    agents = _agents_routing(root, names)
    contract = _contract_stages(root, names)
    for name in sorted(set(agents) & set(contract)):
        extra = agents[name] - contract[name]
        if extra:
            errors.append("skill %s is routed to %s by AGENTS.md but %s routes it only to %s"
                          % (name, ', '.join(sorted(extra)), CONTRACT_DOC,
                             ', '.join(sorted(contract[name]))))
    return errors


def local_layer_errors(root, expected):
    """Registered local layers must exist, and the agent must be pointed at them."""
    path = root / LOCAL_LAYER_REGISTRY
    if not path.is_file():
        return ["local layer registry missing: " + LOCAL_LAYER_REGISTRY]
    try:
        registry = json.loads(path.read_text(encoding="utf-8"))
    except ValueError:
        return ["local layer registry is not valid JSON: " + LOCAL_LAYER_REGISTRY]
    if not isinstance(registry, dict):
        return ["local layer registry must map a skill name to its layer files"]
    directories = {}
    for rel in expected:
        if rel.endswith('/SKILL.md'):
            directories.setdefault(rel.split('/')[-2], []).append(rel.rsplit('/', 1)[0])
    lines = []
    for rel in SKILL_ROUTING_DOCS:
        document = root / rel
        if document.is_file():
            lines.extend(document.read_text(encoding='utf-8').splitlines())
    errors = []
    for skill, files in sorted(registry.items()):
        if skill not in directories:
            errors.append("local layer registry names %s which is not a shipped skill" % skill)
            continue
        if not isinstance(files, list) or not files:
            errors.append("local layer registry lists no file for %s" % skill)
            continue
        for name in files:
            if not any((root / directory / name).is_file() for directory in directories[skill]):
                errors.append("local layer %s/%s is registered but does not exist" % (skill, name))
            if not any(re.search(_skill_pattern(skill), line) and name in line for line in lines):
                errors.append("local layer %s/%s is registered but no live document points the agent at it"
                              % (skill, name))
    return errors


def main():
    root = Path(__file__).resolve().parents[1]
    manifest = json.loads((root / MANIFEST).read_text(encoding="utf-8"))
    expected = manifest["files"]
    errors = inventory_errors(root, expected)
    for rel in expected:
        if Path(rel).name == 'PROJECT-START.md' and rel != 'templates/PROJECT-START.md':
            errors.append('private startup input in distribution: ' + rel)
        if Path(rel).name in ('acquisition.json', 'request.json', 'analysis-result.json'):
            errors.append('private launch state in distribution: ' + rel)
        parts = Path(rel).parts
        if (len(parts) == 1 and rel not in ROOT_FILES) or (len(parts) > 1 and parts[0] not in ROOT_DIRS):
            errors.append("outside distribution roots: " + rel)
        file = root / rel
        if not file.is_file():
            continue
        if rel.endswith(".md"):
            errors.extend(link_errors(root, file))
            errors.extend(emphasis_errors(root, rel, file.read_text(encoding="utf-8")))
        if rel.endswith(".py") or rel == "tools/check-framework":
            ast.parse(file.read_text(encoding="utf-8"), filename=rel)
        if rel.endswith(".sh"):
            check = subprocess.run(["bash", "-n", str(file)], capture_output=True, text=True)
            if check.returncode:
                errors.append("shell syntax: " + rel)
        if rel.endswith(".pdf"):
            continue
        body = file.read_text(encoding="utf-8")
        # Machine-specific paths and common credential formats, not a full secret detector.
        if re.search(r"/Users/|github_pat_[A-Za-z0-9_]{20,}|gh[pousr]_[A-Za-z0-9]{30,}|-----BEGIN (?:RSA |OPENSSH )?PRIVATE KEY-----", body) and rel != "tools/check-framework":
            errors.append("private identity or credential pattern: " + rel)
    skills = sorted(p for p in expected if p.endswith("/SKILL.md"))
    if len(skills) != sum(manifest['skills'].values()):
        errors.append("skill entrypoint count does not match manifest: " + str(len(skills)))
    errors.extend(invocation_errors(root, expected))
    errors.extend(doc_contract_errors(root, expected))
    errors.extend(status_dictionary_errors(root, expected))
    errors.extend(skill_routing_errors(root, expected))
    errors.extend(local_layer_errors(root, expected))
    if errors:
        for error in errors:
            print("FAIL: " + error, file=sys.stderr)
        return 1
    print("PASS: %d inventoried files, %d skills; hashes, links, syntax, invocation forms, document contract, status vocabulary, skill routing and local layers"
          % (len(expected), len(skills)))
    return 0

if __name__ == "__main__":
    try:
        sys.exit(main())
    except (ValueError, OSError, KeyError, SyntaxError) as error:
        print("FAIL: " + str(error), file=sys.stderr)
        sys.exit(1)
