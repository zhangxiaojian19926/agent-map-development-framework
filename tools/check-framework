#!/usr/bin/env python3
"""Read-only checks of the explicit public distribution (Python stdlib only)."""
import ast
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
from urllib.parse import unquote

MANIFEST = "framework-manifest.json"
SKIP = {".git", "__pycache__", ".DS_Store", ".superpowers"}
ROOT_FILES = {"AGENTS.md", "README.md", "LICENSE", "THIRD_PARTY_NOTICES.md",
              "CHANGELOG.md", ".gitignore", MANIFEST}
ROOT_DIRS = {"docs", "skill", "templates", "tests", "tools", ".github", "openspec"}

def inventory(root):
    result = {}
    for directory, dirs, names in os.walk(root, followlinks=False):
        for name in list(dirs):
            path = Path(directory) / name
            if name in SKIP:
                dirs.remove(name)
            elif path.is_symlink():
                raise ValueError("Symlink directory: " + str(path.relative_to(root)))
        for name in names:
            path = Path(directory) / name
            rel = path.relative_to(root).as_posix()
            if name in SKIP or name.endswith(".pyc") or rel == MANIFEST:
                continue
            if path.is_symlink():
                raise ValueError("Symlink file: " + rel)
            result[rel] = hashlib.sha256(path.read_bytes()).hexdigest()
    return dict(sorted(result.items()))

def inventory_errors(root, expected):
    actual = inventory(root)
    errors = []
    for file in sorted(actual.keys() - expected.keys()):
        errors.append("unexpected file: " + file)
    for file in sorted(expected.keys() - actual.keys()):
        errors.append("missing file: " + file)
    for file in sorted(expected.keys() & actual.keys()):
        if expected[file] != actual[file]:
            errors.append("fingerprint mismatch: " + file)
    return errors

def link_errors(root, file):
    text = re.sub(r"```[\s\S]*?```", "", file.read_text(encoding="utf-8"))
    errors = []
    for match in re.finditer(r"\[[^\]]*\]\(([^)]+)\)", text):
        target = match.group(1).split("#")[0]
        if not target or re.match(r"^[a-zA-Z][\w+.-]*:", target) or "<" in target or ">" in target:
            continue
        resolved = (file.parent / unquote(target)).resolve()
        try:
            resolved.relative_to(root.resolve())
        except ValueError:
            errors.append(str(file.relative_to(root)) + ": link escapes distribution")
            continue
        if not resolved.exists():
            errors.append(str(file.relative_to(root)) + ": broken link " + target)
    return errors

def main():
    root = Path(__file__).resolve().parents[1]
    manifest = json.loads((root / MANIFEST).read_text(encoding="utf-8"))
    expected = manifest["files"]
    errors = inventory_errors(root, expected)
    for rel in expected:
        parts = Path(rel).parts
        if (len(parts) == 1 and rel not in ROOT_FILES) or (len(parts) > 1 and parts[0] not in ROOT_DIRS):
            errors.append("outside distribution roots: " + rel)
        file = root / rel
        if not file.is_file():
            continue
        if rel.endswith(".md"):
            errors.extend(link_errors(root, file))
        if rel.endswith(".py") or rel == "tools/check-framework":
            ast.parse(file.read_text(encoding="utf-8"), filename=rel)
        if rel.endswith(".sh"):
            check = subprocess.run(["bash", "-n", str(file)], capture_output=True, text=True)
            if check.returncode:
                errors.append("shell syntax: " + rel)
        body = file.read_text(encoding="utf-8")
        # Machine-specific paths and common credential formats, not a full secret detector.
        if re.search(r"/Users/|github_pat_[A-Za-z0-9_]{20,}|gh[pousr]_[A-Za-z0-9]{30,}|-----BEGIN (?:RSA |OPENSSH )?PRIVATE KEY-----", body) and rel != "tools/check-framework":
            errors.append("private identity or credential pattern: " + rel)
    skills = sorted(p for p in expected if p.endswith("/SKILL.md"))
    if len(skills) != sum(manifest['skills'].values()):
        errors.append("skill entrypoint count does not match manifest: " + str(len(skills)))
    if errors:
        for error in errors:
            print("FAIL: " + error, file=sys.stderr)
        return 1
    print("PASS: %d inventoried files, %d skills; hashes, links and script syntax" % (len(expected), len(skills)))
    return 0

if __name__ == "__main__":
    try:
        sys.exit(main())
    except (ValueError, OSError, KeyError, SyntaxError) as error:
        print("FAIL: " + str(error), file=sys.stderr)
        sys.exit(1)
